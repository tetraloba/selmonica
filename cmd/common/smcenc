if test $# -lt 1; then
    DATES=`date "+%Y%m%d" --date '1 day ago'`
else
    DATES=$@;
fi;

SRCDIR="${HOME}/selmonica/captured";
DESTDIR="${HOME}/selmonica/encoded";
mkdir "${DESTDIR}"

for DATE in $DATES; do
    ffmpeg -an -r 30 -i "${SRCDIR}/${DATE}/%04d.jpg" -vcodec libx264 -pix_fmt yuv420p "${DESTDIR}/${DATE}.mp4";
done;
